{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imfid.intermarche.com/schemas/rule/MONTHLY_DATE_EARN.json",
  "title": "Jour fixe du mois",
  "description": "Percentage on a fixed day of the month, once per period, capped, for a community (§12).",
  "type": "object",
  "x-label": "Jour fixe du mois",
  "properties": {
    "dayOfMonth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "x-widget": "day-of-month",
      "x-label": "Jour du mois"
    },
    "communityCode": {
      "type": "string",
      "minLength": 1,
      "x-widget": "community",
      "x-label": "Communauté"
    },
    "scope": { "$ref": "#/$defs/scope" },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-widget": "rate",
      "x-label": "Taux"
    }
  },
  "required": ["dayOfMonth", "communityCode", "scope", "rate"],
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "x-widget": "scope",
      "x-label": "Assiette",
      "properties": {
        "wholeStore": { "type": "boolean", "x-widget": "toggle", "x-label": "Tout le magasin" },
        "include": { "$ref": "#/$defs/scopeSet", "x-label": "Inclusions" },
        "exclude": { "$ref": "#/$defs/scopeSet", "x-label": "Exclusions" }
      },
      "additionalProperties": false
    },
    "scopeSet": {
      "type": "object",
      "properties": {
        "brands": { "type": "array", "items": { "type": "string" }, "x-widget": "string-list", "x-label": "Marques" },
        "families": { "type": "array", "items": { "type": "string" }, "x-widget": "string-list", "x-label": "Familles" },
        "eans": { "type": "array", "items": { "type": "string" }, "x-widget": "ean", "x-label": "EAN" }
      },
      "additionalProperties": false
    }
  }
}
